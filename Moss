    _addBC(ball,ball.Touched:Connect(function(hit)
        if hit.Parent~=_character or not _ALLOWED[hit.Name] or _debWeld[ball] then return end
        _debWeld[ball]=true; nukeWeldsL1(ball); task.delay(0.03,function() _debWeld[ball]=nil end)
    end))
end

