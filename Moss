local _nukeT={}; local _nukeDeepT={}
local function sweepForBall(parent,ball)
    for _,o in ipairs(parent:GetChildren()) do
        local c=o.ClassName
        if c=="Weld" or c=="WeldConstraint" or c=="Motor6D" then
            local ok0,p0=pcall(function() return o.Part0 end); local ok1,p1=pcall(function() return o.Part1 end)
            if (ok0 and p0==ball) or (ok1 and p1==ball) then pcall(function() o:Destroy() end) end
        end
