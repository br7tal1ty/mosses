        task.defer(function()
            pcall(function()
                local sys=workspace:FindFirstChild("TPSSystem"); local rb=sys and sys:FindFirstChild("TPS") or workspace:FindFirstChild("Ball")
                if not rb then return end
                for _,o in ipairs(ball:GetChildren()) do if o:IsA("WeldConstraint") then return end end
                local wc=Instance.new("WeldConstraint"); wc.Part0=ball; wc.Part1=rb; wc.Parent=ball
            end)
