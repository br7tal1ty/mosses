            end
            local urg=clamp(1-tImpact*2.222,0,1)
            local predBx=bx+vx*ahead; local predBy=by+vy*ahead+GRAV*ahead*ahead; local predBz=bz+vz*ahead
            local toHx=hpx-predBx; local toHy=hpy-predBy; local toHz=hpz-predBz
            local thl=sqrt(toHx*toHx+toHy*toHy+toHz*toHz); local conv=0
            if thl>0.001 then conv=vx*(toHx/thl)+vy*(toHy/thl)+vz*(toHz/thl) end
            local effR=dR+clamp(conv*0.028,0,1)*0.9+urg*0.7
            local phx=hpx+ahead*rvx; local phy=hpy+ahead*rvy; local phz=hpz+ahead*rvz
            for i=1,6 do
                local dx=_AX[i]-phx; local dy=_AY[i]-phy; local dz=_AZ[i]-phz
                if dx*dx+dz*dz<=effR*effR and dy<=dRY and dy>0.2 then
                    headerHit=true; fti(ball,_head,0); fti(ball,_head,1); break
                end
            end
        end
        if headerHit then
            if not headerActive then headerActive=true; setFlag(1,true) end
            if not headerTouching then
                headerTouching=true
                pcall(function()
                    local cur=ball.AssemblyLinearVelocity; local look=camera.CFrame.LookVector
                    local relSpd=sqrt((vx-rvx)^2+(vy-rvy)^2+(vz-rvz)^2)
                    local power=12+clamp(relSpd*0.083,0,10)+clamp(-vy*0.063,0,6)
                    ball.AssemblyLinearVelocity=V3(look.X*power*58,cur.Y+power*5,look.Z*power*58)
                end)
                nukeWeldsDeep(ball)
            end
        else
            headerTouching=false; if headerActive then headerActive=false; setFlag(1,false) end
        end
        local volleyHit=false
        for i=1,8 do
            local dx=_AX[i]-rx; local dy=_AY[i]-ry; local dz=_AZ[i]-rz
            if dx*dx+dz*dz<=VOLLEY_XZ*VOLLEY_XZ and dy<=VOLLEY_Y and dy>-3 then
                volleyHit=true; fireLeg(ball); break
            end
        end
        if volleyHit then
            if rawDistSq<=20.25 then
                if not airLegActive then
                    airLegActive=true; setFlag(2,true)
                    pcall(function() local cur=ball.AssemblyLinearVelocity; if cur.Y>-50 then ball.AssemblyLinearVelocity=V3(cur.X,-abs(cur.Y)-48,cur.Z) end end)
                end
                airLegTouching=true
            else
                if airLegTouching then airLegTouching=false; airLegActive=false; setFlag(2,false) end
            end
        else
            if airLegActive then airLegActive=false; airLegTouching=false; setFlag(2,false) end
        end
    else
        if headerActive then headerActive=false; setFlag(1,false) end
        if airLegActive then airLegActive=false; setFlag(2,false) end
        headerTouching=false; airLegTouching=false
        local fired=false
        for i=1,8 do
            if not fired then
                local dx=_AX[i]-rx; local dy=_AY[i]-ry; local dz=_AZ[i]-rz
                if abs(dx)<=GROUND_REACH and abs(dz)<=GROUND_REACH and abs(dy)<=2.8 then fireLeg(ball); fired=true end
            end
        end
        if not fired then
            local bspdH=sqrt(vx*vx+vz*vz); local extR=GROUND_REACH+cachedPing*bspdH*0.7; local extRsq=extR*extR
            for i=1,8 do
                if not fired then
                    local ex=_AX[i]-rx; local ey=_AY[i]-ry; local ez=_AZ[i]-rz
                    if ex*ex+ey*ey+ez*ez<=extRsq then fireLeg(ball); fired=true end
                end
            end
        end
        if not fired and rawDistSq<=(GROUND_REACH*1.8)^2 then fireLeg(ball) end
    end
end)

