local function interceptBV(ball,bv)
    local function cap() pcall(function() local v=bv.Velocity; local h=v.X*v.X+v.Z*v.Z; if h>121 then local s=11/sqrt(h); bv.Velocity=V3(v.X*s,v.Y,v.Z*s) end end) end
    cap(); _addBC(ball,bv:GetPropertyChangedSignal("Velocity"):Connect(cap))
end
local function interceptBF(ball,bf)
    local function cap() pcall(function() local f=bf.Force; local m=f.Magnitude; if m>180 then bf.Force=f*(180/m) end end) end
    cap(); _addBC(ball,bf:GetPropertyChangedSignal("Force"):Connect(cap))
end
local function interceptAV(ball,av)
    pcall(function() av.AngularVelocity=V3zero end)
    _addBC(ball,av:GetPropertyChangedSignal("AngularVelocity"):Connect(function() pcall(function() av.AngularVelocity=V3zero end) end))
end
local function watchBall(ball)
    for _,c in ipairs(ball:GetChildren()) do
        if c:IsA("BodyVelocity") then interceptBV(ball,c) elseif c:IsA("BodyForce") then interceptBF(ball,c) elseif c:IsA("AngularVelocity") then interceptAV(ball,c) end
    end
    _addBC(ball,ball.ChildAdded:Connect(function(c)
        if c:IsA("BodyVelocity") then interceptBV(ball,c) elseif c:IsA("BodyForce") then interceptBF(ball,c) elseif c:IsA("AngularVelocity") then interceptAV(ball,c) end
    end))
end
local function addBall(ball)
    if _allBalls[ball] then return end; _allBalls[ball]=true; watchBall(ball)
