local HEADER_POWER   = 5
local INSIDE_THRESH  = 2.5
local HIGH_PING_MS   = 0.10
local GRAV_HALF_SQ   = -9.8 * 0.5 * (1/60) * (1/60)
local camera         = workspace.CurrentCamera

local _ball = nil
local function getBall()
    if _ball and _ball.Parent then return _ball end
    local sys = workspace:FindFirstChild("TPSSystem")
    _ball = (sys and sys:FindFirstChild("TPS")) or workspace:FindFirstChild("Ball")
    return _ball
end

local _root, _hum, _head, _rleg, _lleg
local _hasRleg, _hasLleg = false, false
local function refreshChar(char)
    if not char then return end
    _root    = char:FindFirstChild("HumanoidRootPart")
    _hum     = char:FindFirstChild("Humanoid")
    _head    = char:FindFirstChild("Head")
    _rleg    = char:FindFirstChild("RightLowerLeg") or char:FindFirstChild("Right Leg")
    _lleg    = char:FindFirstChild("LeftLowerLeg")  or char:FindFirstChild("Left Leg")
    _hasRleg = _rleg ~= nil
    _hasLleg = _lleg ~= nil
end
refreshChar(lp.Character)
lp.CharacterAdded:Connect(function(c)
    task.wait(); refreshChar(c)
    c.ChildAdded:Connect(function() refreshChar(c) end)
end)

local _lastWriteT = ""
local _lastWriteI = ""
local function writeFlags(t, i)
    if t == _lastWriteT and i == _lastWriteI then return end
    _lastWriteT = t; _lastWriteI = i
    if not setfflag then return end
    pcall(function()
        if     getfflag(_FK_T_CK) ~= nil then setfflag(_FK_T_CK, t)
        elseif getfflag(_FK_T_RW) ~= nil then setfflag(_FK_T_RW, t) end
    end)
    pcall(function()
        if     getfflag(_FK_I_CK) ~= nil then setfflag(_FK_I_CK, i)
        elseif getfflag(_FK_I_RW) ~= nil then setfflag(_FK_I_RW, i) end
    end)
end

local _flagStack  = {false, false}
local FL_PRIORITY = {
    {t="0", i="60"},
    {t="0", i="60"},
}
local function resolveFlags()
    for i = 1, 2 do
        if _flagStack[i] then
            writeFlags(FL_PRIORITY[i].t, FL_PRIORITY[i].i)
            return
        end
    end
    writeFlags("7", "60")
end
local function setFlag(idx, state)
    if _flagStack[idx] == state then return end
    _flagStack[idx] = state
    resolveFlags()
end

local BUF_MAX = 8
local POS_BUF = {}
for i = 1, BUF_MAX do POS_BUF[i] = {t=0, pos=V3zero, vel=V3zero} end
local POS_HEAD = 0
local POS_LEN  = 0

local function recordBall(ball)
    POS_HEAD = (POS_HEAD % BUF_MAX) + 1
    local s  = POS_BUF[POS_HEAD]
    s.t   = clock()
    s.pos = ball.Position
    s.vel = ball.AssemblyLinearVelocity
    if POS_LEN < BUF_MAX then POS_LEN = POS_LEN + 1 end
end

local function getFrame(offset)
    return POS_BUF[((POS_HEAD - offset - 1) % BUF_MAX) + 1]
end

local function smartPredict(ball, ahead)
    if POS_LEN < 2 then
        if not ball then return V3zero, V3zero end
        return ball.Position + ball.AssemblyLinearVelocity * ahead, ball.AssemblyLinearVelocity
    end
    local s2 = getFrame(0); local s1 = getFrame(1)
    local dt  = s2.t - s1.t; if dt <= 0 then dt = 0.016 end
    local vpx = (s2.pos.X - s1.pos.X) / dt
    local vpy = (s2.pos.Y - s1.pos.Y) / dt
    local vpz = (s2.pos.Z - s1.pos.Z) / dt
    local vrx = s2.vel.X; local vry = s2.vel.Y; local vrz = s2.vel.Z
    local ddx = vrx-vpx; local ddy = vry-vpy; local ddz = vrz-vpz
    local kb  = clamp((ddx*ddx + ddy*ddy + ddz*ddz) / (35*35), 0, 1)
    local blx = vpx*(1-kb) + vrx*kb
    local bly = vpy*(1-kb) + vry*kb
    local blz = vpz*(1-kb) + vrz*kb
    local ax, ay, az = 0, 0, 0
    if POS_LEN >= 3 then
        local s0  = getFrame(2); local dt0 = s1.t - s0.t
        if dt0 > 0 then
            local v0x = (s1.pos.X - s0.pos.X)/dt0
            local v0y = (s1.pos.Y - s0.pos.Y)/dt0
            local v0z = (s1.pos.Z - s0.pos.Z)/dt0
            local amax = 120
            ax = clamp((vpx-v0x)/dt, -amax, amax)
            ay = clamp((vpy-v0y)/dt, -amax, amax)
            az = clamp((vpz-v0z)/dt, -amax, amax)
        end
    end
    local gravY = -9.8 * ahead * ahead * (1 - kb)
    local t     = clamp(ahead, 0.016, 0.25)
    local half  = 0.5*t*t
    return V3(s2.pos.X + blx*t + ax*half,
              s2.pos.Y + bly*t + ay*half + gravY,
              s2.pos.Z + blz*t + az*half),
           V3(blx, bly, blz)
end

local function calcDynamicReach(ballPosY, predVel, rootY)
    local velY       = predVel.Y
    local velX       = predVel.X
    local velZ       = predVel.Z
    local heightDiff = ballPosY - rootY
    local latSpdSq   = velX*velX + velZ*velZ
    local latSpd     = clamp(sqrt(latSpdSq) / 40, 0, 1)
    local dropSpeed  = clamp(-velY / 60, 0, 1)
    local heightBon  = clamp((heightDiff - 4) / 8, 0, 1)
    local timeToArr  = (velY < -1) and (heightDiff / -velY) or 99
    local urgency    = clamp(1 - timeToArr / 0.3, 0, 1)
    local dynY       = clamp(BASE_AIR.Y + dropSpeed*2.0 + heightBon*1.0 + urgency*1.0, BASE_AIR.Y, 5.5)
    local zApp       = clamp(abs(velZ) / 20, 0, 1)
    local totalSpd   = sqrt(latSpdSq + velY*velY)
    local slowPen    = clamp(1 - totalSpd/15, 0, 1) * 0.7
    local tooHigh    = clamp((heightDiff - 5) / 3, 0, 1) * 1.4
    local dynZ       = clamp(BASE_AIR.Z + latSpd*0.8 + zApp*0.6 - slowPen - tooHigh, 1.2, 3.2)
    local xApp       = clamp(abs(velX) / 20, 0, 1)
    local dynX       = clamp(BASE_AIR.X + latSpd*0.5 + xApp*0.6 - tooHigh, 1.6, 4.2)
    return dynX*0.75, dynZ*0.75, dynY*0.75
end

local function fireLegTouch(ball)
    fti(ball,_root,0); fti(ball,_root,1)
    if _hasRleg then fti(ball,_rleg,0); fti(ball,_rleg,1) end
    if _hasLleg then fti(ball,_lleg,0); fti(ball,_lleg,1) end
end

local headerActive   = false
local headerTouching = false
local airLegActive   = false
local airLegTouching = false

local _cachedPing = 0.05
local _lastPingT  = 0

RunService.Heartbeat:Connect(function()
    local now  = clock()
    local ball = getBall()

    if now - _lastPingT >= 2 then
        _lastPingT  = now
        _cachedPing = clamp(lp:GetNetworkPing(), 0.016, 0.25)
    end

    if _cachedPing >= HIGH_PING_MS and ball and _root then
        local bp  = ball.Position
        local bv  = ball.AssemblyLinearVelocity
        local rp  = _root.Position
        local ext = _cachedPing * 0.6
        local ps  = clamp((_cachedPing - HIGH_PING_MS) / 0.10, 0, 1)
        local spx = bp.X + bv.X*ext - rp.X
        local spy = bp.Y + bv.Y*ext - rp.Y
        local spz = bp.Z + bv.Z*ext - rp.Z
        local gr  = GROUND_REACH + ps * 1.5
        if abs(spx) <= gr and abs(spy) <= gr and abs(spz) <= gr then
            fireLegTouch(ball)
        end
        if _hum and _hum.FloorMaterial == MAT_AIR then
            local vr = VOLLEY_REACH + ps * 1.5
            if abs(spx) <= vr and abs(spz) <= vr and abs(spy) <= vr then
                fireLegTouch(ball)
            end
            if _head then
                local hp  = _head.Position
                local shx = bp.X + bv.X*ext - hp.X
                local shy = bp.Y + bv.Y*ext - hp.Y
                local shz = bp.Z + bv.Z*ext - hp.Z
                local hr  = (1.6 + ps * 0.6) * 0.75
                if shx*shx + shy*shy + shz*shz <= hr*hr then
                    fti(ball, _head, 0); fti(ball, _head, 1)
                end
            end
        end
    end
end)

RunService.PreSimulation:Connect(function()
    if not _root or not _hum then return end
    local ball = getBall()
    if not ball then return end

    local ballPos = ball.Position
    local rootPos = _root.Position
    local qdx = ballPos.X - rootPos.X
    local qdz = ballPos.Z - rootPos.Z
    if abs(qdx) > 14 or abs(qdz) > 14 then return end

    local isJumping = _hum.FloorMaterial == MAT_AIR
    recordBall(ball)

    local qdy     = ballPos.Y - rootPos.Y
    local rawDist = sqrt(qdx*qdx + qdy*qdy + qdz*qdz)
    local ahead   = _cachedPing + 1/60

    local predPos, predVel
    if _cachedPing >= HIGH_PING_MS or rawDist >= 7 then
        predPos, predVel = smartPredict(ball, ahead)
    else
        predPos = ballPos
        predVel = ball.AssemblyLinearVelocity
    end

    local pvx = predVel.X; local pvy = predVel.Y; local pvz = predVel.Z
    local farPos = V3(
        predPos.X + pvx*(1/60),
        predPos.Y + pvy*(1/60) + GRAV_HALF_SQ,
        predPos.Z + pvz*(1/60)
    )

    local dx  = predPos.X - rootPos.X
    local dy  = predPos.Y - rootPos.Y
    local dz  = predPos.Z - rootPos.Z
    local fdx = farPos.X  - rootPos.X
    local fdy = farPos.Y  - rootPos.Y
    local fdz = farPos.Z  - rootPos.Z

    local headPart = _head or _root

    if rawDist < INSIDE_THRESH then
        fireLegTouch(ball)
    end

    if isJumping then
        local dynX, dynZ, dynY = calcDynamicReach(ballPos.Y, predVel, rootPos.Y)

        local inHeader = (dy > 0.8 and abs(dx) <= dynX and abs(dz) <= dynZ and dy <= dynY)
            or (fdy > 0.8 and abs(fdx) <= dynX and abs(fdz) <= dynZ and fdy <= dynY)

        if inHeader then
            fti(ball, headPart, 0); fti(ball, headPart, 1)

            local headPos  = _head and _head.Position or rootPos
            local rootVel  = _root.AssemblyLinearVelocity
            local phx_base = headPos.X + rootVel.X*ahead
            local phy_base = headPos.Y + rootVel.Y*ahead
            local phz_base = headPos.Z + rootVel.Z*ahead

            local phx = predPos.X - phx_base
            local phy = predPos.Y - phy_base
            local phz = predPos.Z - phz_base
            local predHeadDistSq = phx*phx + phy*phy + phz*phz

            local fhx = farPos.X - phx_base
            local fhy = farPos.Y - phy_base
            local fhz = farPos.Z - phz_base
            local farHeadDistSq = fhx*fhx + fhy*fhy + fhz*fhz

            local toHeadX = phx_base - predPos.X
            local toHeadY = phy_base - predPos.Y
            local toHeadZ = phz_base - predPos.Z
            local toHeadLen = sqrt(toHeadX*toHeadX + toHeadY*toHeadY + toHeadZ*toHeadZ)
            local convergence = 0
            if toHeadLen > 0.001 then
                local ux = toHeadX / toHeadLen
                local uy = toHeadY / toHeadLen
                local uz = toHeadZ / toHeadLen
                convergence = pvx*ux + pvy*uy + pvz*uz
            end
            local convBonus    = clamp(convergence / 40, 0, 1) * 0.9
            local effContactSq = (1.6 + convBonus) * 0.75 * ((1.6 + convBonus) * 0.75)

            if predHeadDistSq <= effContactSq or farHeadDistSq <= effContactSq then
                if not headerActive then
                    headerActive = true
                    setFlag(1, true)
                end
                if not headerTouching then
                    headerTouching = true
                    pcall(function()
                        local cur = ball.AssemblyLinearVelocity
                        if cur.Magnitude < 80 then
                            local look    = camera.CFrame.LookVector
                            local fallSpd = max(-cur.Y, 0)
                            local boost   = clamp(fallSpd / 40, 0, 1)
                            local power   = HEADER_POWER * (1 + boost * 2.5)
                            ball.AssemblyLinearVelocity = V3(look.X*power*60, cur.Y, look.Z*power*60)
                        end
                    end)
                end
            else
                headerTouching = false
                if headerActive then headerActive = false; setFlag(1, false) end
            end
        else
            if headerActive then headerActive = false; setFlag(1, false) end
            headerTouching = false
        end

        local inVolley = (abs(dx) <= VOLLEY_REACH and abs(dz) <= VOLLEY_REACH and abs(dy) <= VOLLEY_REACH_Y)
            or (abs(fdx) <= VOLLEY_REACH and abs(fdz) <= VOLLEY_REACH and abs(fdy) <= VOLLEY_REACH_Y)

        if inVolley then
            fireLegTouch(ball)
            if rawDist <= 3.5 then
                if not airLegActive then
                    airLegActive = true
                    setFlag(2, true)
                end
                airLegTouching = true
            else
                if airLegTouching then
                    airLegTouching = false; airLegActive = false
                    setFlag(2, false)
                end
            end
        else
            if airLegActive then
                airLegActive = false; airLegTouching = false
                setFlag(2, false)
            end
        end

    else
        if headerActive then headerActive = false; setFlag(1, false) end
        if airLegActive then airLegActive = false; setFlag(2, false) end
        headerTouching = false; airLegTouching = false

        local inGround = (abs(dx) <= GROUND_REACH and abs(dz) <= GROUND_REACH and abs(dy) <= GROUND_REACH)
            or (abs(fdx) <= GROUND_REACH and abs(fdz) <= GROUND_REACH and abs(fdy) <= GROUND_REACH)

        if inGround then
            fireLegTouch(ball)
        end
    end
end)

lp.CharacterRemoving:Connect(function()
    _flagStack = {false, false}
    resolveFlags()
end)
