local BUF_MAX=10; local POS_BUF={}
for i=1,BUF_MAX do POS_BUF[i]={t=0,px=0,py=0,pz=0,vx=0,vy=0,vz=0} end
local POS_HEAD=0; local POS_LEN=0
local function recordBall(bx,by,bz,vvx,vvy,vvz)
    POS_HEAD=(POS_HEAD%BUF_MAX)+1; local s=POS_BUF[POS_HEAD]
    s.t=clock(); s.px=bx; s.py=by; s.pz=bz; s.vx=vvx; s.vy=vvy; s.vz=vvz
    if POS_LEN<BUF_MAX then POS_LEN=POS_LEN+1 end
end
local function getFrame(off) return POS_BUF[((POS_HEAD-off-1)%BUF_MAX)+1] end
local function smartPredict(bx,by,bz,vx,vy,vz,ahead)
    if POS_LEN<2 then local t2=ahead*ahead; return bx+vx*ahead,by+vy*ahead+GRAV*t2,bz+vz*ahead,vx,vy,vz,0 end
    local s2=getFrame(0); local s1=getFrame(1); local dt=s2.t-s1.t; if dt<=0 then dt=0.016 end
    local idt=1/dt
    local vpx=(s2.px-s1.px)*idt; local vpy=(s2.py-s1.py)*idt; local vpz=(s2.pz-s1.pz)*idt
    local vrx=s2.vx; local vry=s2.vy; local vrz=s2.vz
    local ddx=vrx-vpx; local ddy=vry-vpy; local ddz=vrz-vpz
    local kb=clamp((ddx*ddx+ddy*ddy+ddz*ddz)*(1/2025),0,1); local kb2=kb*kb
    local blx=vpx*(1-kb2)+vrx*kb2; local bly=vpy*(1-kb2)+vry*kb2; local blz=vpz*(1-kb2)+vrz*kb2
    local ax,ay,az=0,0,0
    if POS_LEN>=3 then
        local s0=getFrame(2); local dt0=s1.t-s0.t
        if dt0>0 then
            local idt0=1/dt0; local am=115; local iAvg=2/(dt+dt0)
            local v0x=(s1.px-s0.px)*idt0; local v0y=(s1.py-s0.py)*idt0; local v0z=(s1.pz-s0.pz)*idt0
            ax=clamp((vpx-v0x)*iAvg,-am,am); ay=clamp((vpy-v0y)*iAvg,-am,am); az=clamp((vpz-v0z)*iAvg,-am,am)
        end
    end
    local t=clamp(ahead,0.016,0.28); local h=0.5*t*t; local gravBlend=GRAV*t*t*(1-kb2)
    return s2.px+blx*t+ax*h,s2.py+bly*t+ay*h+gravBlend,s2.pz+blz*t+az*h,blx,bly,blz,1-kb2
end

local function arcXYZ(bx,by,bz,vx,vy,vz,t) return bx+vx*t,by+vy*t+GRAV*t*t,bz+vz*t end

local function headerR(bvx,bvy,bvz,rvx,rvy,rvz,hd)
    if not hd or hd<2 or bvy>-4 then return HEADER_BASE end
    local rs=sqrt((bvx-rvx)^2+(bvy-rvy)^2+(bvz-rvz)^2)
    return HEADER_BASE+clamp(-bvy*0.035,0,1)*0.6+clamp(rs*0.04,0,1)*0.8+clamp((hd-2)*0.15,0,1)*0.3
end
local function headerRY(bvy,hd)
    if not hd or hd<2 or bvy>-4 then return 1.8 end
    return 1.8+clamp(-bvy*0.04,0,1)*1.0
end

