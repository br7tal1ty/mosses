        end
    elseif (bx-rx)^2+(by-ry)^2+(bz-rz)^2>(GROUND_REACH*3.2)^2 then
        if not _mouseHeld and sinceRelease>CHAIN_NORM then _lastReleaseT=-999 end
    end
end)

