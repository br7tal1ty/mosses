end
local function nukeWeldsL1(ball)
    local now=clock(); local lt=_nukeT[ball]
    if lt and now-lt<FIRST_NUKE_DB then return end; _nukeT[ball]=now
    for _,o in ipairs(ball:GetChildren()) do if WELD_TYPES[o.ClassName] then pcall(function() o:Destroy() end) end end
end
local function nukeWeldsDeep(ball)
    local now=clock(); local lt=_nukeDeepT[ball]
    if lt and now-lt<INSIDE_NUKE_DB then return end; _nukeDeepT[ball]=now
    for _,o in ipairs(ball:GetChildren()) do if WELD_TYPES[o.ClassName] then pcall(function() o:Destroy() end) end end
    local par=ball.Parent
    if par then sweepForBall(par,ball); local par2=par.Parent; if par2 then sweepForBall(par2,ball) end end
end

